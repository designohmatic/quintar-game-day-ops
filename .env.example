# Quintar Game Day Ops — environment template
# Copy to .env.local and fill in values. Do not commit real secrets.

# ── Slack
# Bot User OAuth Token from the Slack app (api.slack.com/apps → OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-replace-me
# Signing Secret from the app's Basic Information page
SLACK_SIGNING_SECRET=replace-me
# Channel ID (e.g. C01ABC23DEF) where pinned event status messages are posted
SLACK_CHANNEL_ID=C01XXXX

# Base URL used to build links in Slack messages back to the event view.
# Dev: http://localhost:8080  •  Prod: https://playground.quintar.ai
APP_BASE_URL=http://localhost:8080

# ── AppSync (from amplify_outputs.json provided by IT)
APPSYNC_ENDPOINT=https://example.appsync-api.us-east-1.amazonaws.com/event
APPSYNC_REGION=us-east-1
APPSYNC_API_KEY=da2-replace-me

# ── Backend dev server
NODE_ENV=dev
PORT=3005
LOG_LEVEL=debug
CORS_ALLOWED_ORIGIN=http://localhost:5173
DB_PATH=./data/ops.db

# ── Session signing — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-random-string
